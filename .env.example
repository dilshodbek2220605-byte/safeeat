# ============================================================
#  SafeEat AI (TozaRasion) — Environment configuration
#  Bu faylni `.env` ga nusxalab to'ldiring:  cp .env.example .env
# ============================================================

# ---- Umumiy ----
ENV=development
LOG_LEVEL=INFO
# Frontend WebApp URL (Telegram MenuButton uchun ham ishlatiladi)
WEBAPP_URL=http://localhost:5173
# Backend tashqi ko'rinadigan manzil (rasm URL'lar uchun)
API_PUBLIC_URL=http://localhost:8000
# Webhook manzili (production'da https bo'lishi shart)
WEBHOOK_BASE_URL=https://your-domain.example
# CORS: vergul bilan ajratilgan ruxsat etilgan originlar
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
POSTGRES_USER=safeeat
POSTGRES_PASSWORD=safeeat
POSTGRES_DB=safeeat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy async URL (docker ichida host = postgres)
DATABASE_URL=postgresql+asyncpg://safeeat:safeeat@localhost:5432/safeeat

# ---- Redis (rate-limit / replay protection / cache) ----
REDIS_URL=redis://localhost:6379/0

# ---- Telegram ----
# @BotFather bergan token. initData HMAC validatsiyasi uchun ishlatiladi.
BOT_TOKEN=123456:PUT_YOUR_BOT_TOKEN_HERE
# Bot webhook uchun maxfiy sarlavha (ixtiyoriy, tavsiya etiladi)
TELEGRAM_WEBHOOK_SECRET=super-secret-webhook-path

# ---- JWT ----
# `openssl rand -hex 32` bilan generatsiya qiling
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- AI Vision ----
# Provayderlar tartibi: birinchisi asosiy, qolganlari fallback
AI_PROVIDER_ORDER=openai,gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# ---- Rasm saqlash (adapter pattern) ----
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads
MAX_UPLOAD_MB=10
# S3-mos (AWS S3 / Cloudflare R2 / Supabase Storage / MinIO)
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=safeeat
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Rate limiting ----
RATE_LIMIT_ANALYSES_PER_HOUR=20
RATE_LIMIT_WINDOW_SECONDS=3600
